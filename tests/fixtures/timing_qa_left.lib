library (timing_qa_left) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1,pf);
  lu_table_template (delay_2x2) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.1, 0.5");
    index_2 ("0.01, 0.1");
  }
  cell (INVX1) {
    area : 1.0;
    pin (A) { direction : input; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_2x2) {
          index_1 ("0.1, 0.5");
          index_2 ("0.01, 0.1");
          values ("0.10, 0.20", "0.15, 0.25");
        }
        cell_fall (delay_2x2) {
          index_1 ("0.1, 0.5");
          index_2 ("0.01, 0.1");
          values ("0.11, 0.21", "0.16, 0.26");
        }
        rise_transition (delay_2x2) {
          values ("0.05, 0.08", "0.06, 0.09");
        }
      }
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        when : "left_only";
        cell_rise (delay_2x2) {
          values ("0.30, 0.40", "0.35, 0.45");
        }
      }
    }
  }
  cell (INVX2) {
    area : 2.0;
    pin (A) { direction : input; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_2x2) {
          values ("0.08, 0.16", "0.12, 0.20");
        }
      }
    }
  }
  cell (BUF_MONO) {
    area : 1.2;
    pin (A) { direction : input; }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (delay_2x2) {
          index_1 ("0.1, 0.5");
          index_2 ("0.01, 0.1");
          values ("0.10, 0.09", "0.15, 0.25");
        }
      }
    }
  }
}
