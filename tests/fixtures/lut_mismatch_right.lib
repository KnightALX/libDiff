library (lut_mismatch_right) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  capacitive_load_unit (1,pf);
  leakage_power_unit : "1nW";
  lu_table_template (delay_2x3) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.1, 0.3, 0.5");
    index_2 ("0.01, 0.05, 0.1");
  }
  lu_table_template (constraint_1x3) {
    variable_1 : related_pin_transition;
    index_1 ("0.1, 0.3, 0.5");
  }
  cell (INVX1) {
    area : 1.1;
    pin (A) { direction : input; capacitance : 0.01; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_2x3) {
          index_1 ("0.1, 0.3, 0.5");
          index_2 ("0.01, 0.05, 0.1");
          values ("0.11, 0.16, 0.21", "0.13, 0.18, 0.23", "0.16, 0.21, 0.26");
        }
        rise_constraint (constraint_1x3) {
          index_1 ("0.1, 0.3, 0.5");
          values ("0.055, 0.065, 0.085");
        }
      }
    }
  }
  cell (INVX2) {
    area : 2.1;
    pin (A) { direction : input; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_2x3) {
          values ("0.09, 0.12, 0.17", "0.11, 0.14, 0.19", "0.13, 0.16, 0.21");
        }
      }
    }
  }
}
